{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "云梭",
  "version": "0.1.11",
  "identifier": "com.deploypilot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "云梭 — 一键打包部署",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.icns"],
    "windows": {
      "nsis": { "languages": ["SimpChinese"], "displayLanguageSelector": false }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}